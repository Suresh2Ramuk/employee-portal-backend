NODE_ENV=production

DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_application_user
DB_PASSWORD=your_application_password
DB_NAME=react_demo_sql

JWT_SECRET=generate_a_new_random_secret
JWT_EXPIRES_IN=1h
OTP_HASH_SECRET=generate_another_random_secret

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_sender_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="Employee Portal <your_sender_email@gmail.com>"